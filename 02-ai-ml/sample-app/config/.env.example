# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API Key (optional, for Claude comparison)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Default model for single-model queries
DEFAULT_MODEL=gpt-4

# Fallback model
FALLBACK_MODEL=gpt-3.5-turbo

# Max tokens per request
MAX_TOKENS=1000

# Cost per 1K tokens (for estimation)
GPT4_INPUT_COST=0.03
GPT4_OUTPUT_COST=0.06
GPT35_INPUT_COST=0.001
GPT35_OUTPUT_COST=0.002

# Routing thresholds
SIMPLEX_THRESHOLD=50
COMPLEX_THRESHOLD=200
