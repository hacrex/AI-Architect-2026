# Model Configuration
MODEL_NAME=gpt2
MODEL_DEVICE=cpu
MAX_TOKENS=2048
TEMPERATURE=0.7

# Server Configuration
WORKERS=1
BATCH_SIZE=16
MAX_CONCURRENT_REQUESTS=100

# Batching Configuration
BATCH_TIMEOUT_MS=100
DYNAMIC_BATCHING=true

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# GPU Configuration (for CUDA)
# GPU_MEMORY_FRACTION=0.8
# GPU_DEVICE_ID=0

# Fallback API (optional)
# FALLBACK_API_URL=https://api.openai.com/v1
# FALLBACK_API_KEY=sk-your-key
