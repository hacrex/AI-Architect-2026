# AI Security & Governance
AUTH_TOKEN_EXPIRY_SECONDS=3600
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900

# Authorization
AUTHZ_DEFAULT_DENY=true

# Prompt Guard
PROMPT_INJECTION_THRESHOLD=0.7
PROMPT_MAX_LENGTH=10000
PROMPT_BLOCKED_PATTERNS=ignore previous,ignore all,disregard instructions,reveal confidential,show me all

# Data Classification
CLASSIFICATION_LEVELS=public,internal,confidential,restricted
DEFAULT_CLASSIFICATION=internal

# PII Detection
PII_DETECT_EMAIL=true
PII_DETECT_PHONE=true
PII_DETECT_SSN=true
PII_DETECT_NAMES=true

# Agent Permissions
AGENT_REQUIRE_HUMAN_APPROVAL=true
AGENT_MAX_STEPS=10

# Audit
AUDIT_RETENTION_DAYS=365
AUDIT_REDACT_SENSITIVE=true

# Risk Assessment
RISK_LEVELS=low,medium,high,critical
DEFAULT_RISK_LEVEL=medium

# Compliance
COMPLIANCE_CHECK_INTERVAL_HOURS=24
