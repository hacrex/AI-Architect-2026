# Semantic Cache
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_MAX_ENTRIES=10000
CACHE_DEFAULT_TTL_SECONDS=3600

# Fallback
FALLBACK_TIMEOUT_SECONDS=5.0
FALLBACK_MAX_RETRIES=2

# Circuit Breaker
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT_SECONDS=30
CB_HALF_OPEN_MAX_CALLS=3

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST_SIZE=10

# Cost Tracking (per 1M tokens)
COST_PER_1M_INPUT_TOKENS=3.0
COST_PER_1M_OUTPUT_TOKENS=15.0
COST_PER_1M_EMBEDDING_TOKENS=0.1
COST_PER_1M_VECTOR_SEARCH=0.01
GPU_COST_PER_HOUR=2.50
MONTHLY_BUDGET_LIMIT_USD=15000.0

# Capacity Planning
BASELINE_REQUESTS_PER_SEC=10
PEAK_MULTIPLIER=10.0
AVG_INPUT_TOKENS_PER_REQUEST=2000
AVG_OUTPUT_TOKENS_PER_REQUEST=500
GPU_INFERENCE_TOKENS_PER_SEC=1000
GPU_MEMORY_GB=24.0

# Latency
LATENCY_P95_TARGET_MS=2000.0
